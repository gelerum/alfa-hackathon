# Только для локальной разработки. Приложения используют те же credentials.
POSTGRES_USER=alfa
POSTGRES_PASSWORD=alfa_dev_password
POSTGRES_DB=alfa_hack
POSTGRES_PORT=5432

# Qwen3-Embedding-0.6B на CPU i7-12700F.
EMBEDDING_PORT=8001
TORCH_NUM_THREADS=8
MAX_INPUT_TOKENS=2048

SEARXNG_PORT=8080
SEARXNG_IMAGE=docker.io/searxng/searxng:latest
# Замени в .env случайной строкой, например: openssl rand -hex 32
SEARXNG_SECRET=local-dev-secret-change-before-sharing

# Адреса для клиентов НА ХОСТЕ. Compose не передаёт их будущим агентам автоматически.
DATABASE_URL=postgresql://alfa:alfa_dev_password@127.0.0.1:5432/alfa_hack
EMBEDDING_BASE_URL=http://127.0.0.1:8001
SEARXNG_BASE_URL=http://127.0.0.1:8080

# Из контейнеров общей сети alpha_default:
# DATABASE_URL=postgresql://alfa:alfa_dev_password@db:5432/alfa_hack
# EMBEDDING_BASE_URL=http://embeddings:8000
# SEARXNG_BASE_URL=http://searxng:8080
