# PostgreSQL — используется compose.yaml.
# Пароль ниже только для локальной разработки.
POSTGRES_USER=alfa
POSTGRES_PASSWORD=alfa_dev_password
POSTGRES_DB=alfa_hack
POSTGRES_PORT=5432

# Для сервиса, запущенного на хосте (не используется самим Compose).
DATABASE_URL=postgresql://alfa:alfa_dev_password@127.0.0.1:5432/alfa_hack
# Из контейнера в той же Docker-сети используй db:5432 вместо 127.0.0.1:5432.

# Пример настроек будущего embedding-клиента (Ollama).
# Пока код их не читает: сами по себе эти переменные модель не подключают.
# URL указан для клиента на хосте; модель устанавливается: ollama pull bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
