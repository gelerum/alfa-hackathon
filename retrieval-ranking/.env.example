# Native uv run: point to your shared DB; this example is the isolated demo database.
RETR_RANK_DATABASE_URL=postgresql://retr_rank_test:retr_rank_test@127.0.0.1:55439/retr_rank_demo

# Compose joins the existing alpha network. Set DATABASE_URL host to db, not localhost.
# ALPHA_NETWORK=alpha_default
# RETR_RANK_DATABASE_URL=postgresql://<user>:<password>@db:5432/<database>

RETR_RANK_VECTOR_TOP_L=5
RETR_RANK_FTS_TOP_B=20
RETR_RANK_MAX_FACETS=16
RETR_RANK_MAX_CANDIDATES=100
RETR_RANK_MAX_FTS_TERMS=32
RETR_RANK_MAX_TERM_CHARACTERS=120
RETR_RANK_MAX_TOP_K=100
RETR_RANK_INCLUDE_UNDATED=false
RETR_RANK_CONNECT_TIMEOUT_SECONDS=5
RETR_RANK_STATEMENT_TIMEOUT_MS=10000
# V0-i2: validated instruction preset; quoted \n sequences restore paragraph breaks.
RETR_RANK_INSTRUCTION="Determine whether the Document reports a concrete event relevant to the business information need in the Query.\n\nThe connection must be supported by the product, industry, market, affected organizations, or operating conditions stated in the Document.\n\nIndustry-level news may be relevant without naming the company. A shared country, city, broad topic, or material word is not enough.\n\nFor regulation, check which organizations and activities it applies to. Do not invent trading routes, suppliers, customers, or user goals.\n\nCovering one listed information need is sufficient."

RETR_RANK_RERANKER_BATCH_SIZE=2
RETR_RANK_RERANKER_MAX_TOKENS=2048
RETR_RANK_CONTEXT_MAX_TOKENS=512
RETR_RANK_TORCH_THREADS=4
RETR_RANK_MODEL_CACHE_DIR=.cache/huggingface/hub
RETR_RANK_MODEL_LOCAL_FILES_ONLY=false
HF_HOME=.cache/huggingface
HF_XET_CACHE=.cache/huggingface/xet
TOKENIZERS_PARALLELISM=false
