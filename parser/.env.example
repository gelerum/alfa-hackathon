# Только для локальной разработки — те же значения, что в ../infrastructure/.env.

# Docker Compose: доступ к общей БД (адрес db:5432 в сети alpha_default подставляется сам)
POSTGRES_USER=alfa
POSTGRES_PASSWORD=alfa_dev_password
POSTGRES_DB=alfa_hack

# Запуск парсера на хосте (python run_parser.py), не в Docker:
DATABASE_URL=postgresql://alfa:alfa_dev_password@127.0.0.1:5432/alfa_hack
EMBEDDING_BASE_URL=http://127.0.0.1:8001

# Ключ embedding_configs — должен совпадать с профайлером
EMBEDDING_CONFIG_KEY=qwen3-embedding-0.6b@97b0c614:v1
EMBED_TIME_BUDGET_MINUTES=20
PARSE_INTERVAL_MINUTES=30
