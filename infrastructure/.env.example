# Copy to infrastructure/.env. Never commit credentials.
# Generate each secret separately: python -c 'import secrets; print(secrets.token_urlsafe(32))'
INTERNAL_TOKEN=
ADMIN_TOKEN=
SEARXNG_SECRET=

# Shared local demo account: automatic login, no password/token entry.
# Disable before any non-demo deployment; revoke existing demo tokens as well.
DEMO_MODE=true
# Optional override of demo companies (synthetic CSV id = fictional name), e.g. U_102920=Нордаква Импорт;U_35210=Химресурс Дистрибуция
DEMO_COMPANIES=
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8092
# For access from another Tailnet machine, set BACKEND_BIND_HOST to the server's Tailscale IP.

POSTGRES_USER=alfa
POSTGRES_PASSWORD=alfa_dev_password
POSTGRES_DB=alfa_hack
# Container address; update consistently if changing PostgreSQL credentials above.
DATABASE_URL=postgresql://alfa:alfa_dev_password@db:5432/alfa_hack

# Qwen3-Embedding-0.6B on CPU.
TORCH_NUM_THREADS=8
MAX_INPUT_TOKENS=2048
EMBEDDING_CONFIG_KEY=qwen3-embedding-0.6b@97b0c614:v1

SEARXNG_IMAGE=docker.io/searxng/searxng:latest

# Only case-approved LLMs. The server must provide Chat Completions.
OPENAI_BASE_URL=
OPENAI_MODEL=qwen3.6-35b-a3b
OPENAI_API_KEY=
OPENAI_MAX_TOKENS=6000
# Seconds per LLM call. Local llama.cpp/vLLM with reasoning models may need several minutes.
OPENAI_TIMEOUT_SECONDS=240
# true sends chat_template_kwargs.enable_thinking=false (Qwen3-style servers): much faster JSON turns.
OPENAI_DISABLE_THINKING=false
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=140
AGENT_TIMEOUT_SECONDS=600
AGENT_MAX_CONTEXT_BYTES=90000
# Cumulative tokens per agent run (each turn resends the context). Local LLM: raise to ~300000.
AGENT_MAX_TOTAL_TOKENS=80000

RANKER_URL=http://retrieval-ranking:8000/rank
RANKER_TIMEOUT_SECONDS=900
RANKER_TORCH_THREADS=4
PARSE_INTERVAL_MINUTES=30
TIMEZONE=Europe/Moscow

# Only backend is published on the host; DB, search and model services use the internal network.

# Optional local generative Qwen3.6-35B-A3B: ./run-docker.sh --with-qwen.
# Embedding and reranker remain enabled in both launch modes.
QWEN_IMAGE=ghcr.io/ggml-org/llama.cpp:server@sha256:5741ab30aae42af23ca57d9b98a6d4544cb09c21f372f92c5ee55312fa8b8b0c
QWEN_MODEL_URL=https://huggingface.co/unsloth/Qwen3.6-35B-A3B-GGUF/resolve/9280dd353ab587157920d5bd391ada414d84e552/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
QWEN_THREADS=8
QWEN_CONTEXT_SIZE=32768
QWEN_STARTUP_TIMEOUT_SECONDS=3600
QWEN_API_TIMEOUT_SECONDS=600
QWEN_AGENT_TIMEOUT_SECONDS=1800
