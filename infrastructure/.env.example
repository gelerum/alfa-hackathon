# Copy to infrastructure/.env. Never commit credentials.
# Generate each secret separately: python -c 'import secrets; print(secrets.token_urlsafe(32))'
INTERNAL_TOKEN=
ADMIN_TOKEN=
SEARXNG_SECRET=

# Shared local demo account: automatic login, no password/token entry.
# Disable before any non-demo deployment; revoke existing demo tokens as well.
DEMO_MODE=true

POSTGRES_USER=alfa
POSTGRES_PASSWORD=alfa_dev_password
POSTGRES_DB=alfa_hack
POSTGRES_PORT=5432
# Container address; update consistently if changing PostgreSQL credentials above.
DATABASE_URL=postgresql://alfa:alfa_dev_password@db:5432/alfa_hack

# Qwen3-Embedding-0.6B on CPU.
EMBEDDING_PORT=8001
TORCH_NUM_THREADS=8
MAX_INPUT_TOKENS=2048
EMBEDDING_CONFIG_KEY=qwen3-embedding-0.6b@97b0c614:v1

SEARXNG_PORT=8080
SEARXNG_IMAGE=docker.io/searxng/searxng:latest

# Only case-approved LLMs. The server must provide Chat Completions.
OPENAI_BASE_URL=http://calculation.tailnet.internal:8001/v1
OPENAI_MODEL=qwen3.6-35b-a3b
OPENAI_API_KEY=
OPENAI_MAX_TOKENS=6000
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=140
AGENT_TIMEOUT_SECONDS=600
AGENT_MAX_CONTEXT_BYTES=90000
AGENT_MAX_TOTAL_TOKENS=80000

# External ranker endpoint; no automatic mock ranking is performed.
RANKER_URL=
PARSE_INTERVAL_MINUTES=30
TIMEZONE=Europe/Moscow

# For host processes override DATABASE_URL to 127.0.0.1:<POSTGRES_PORT>.
# Host embedding API: http://127.0.0.1:8001
# Host search API: http://127.0.0.1:8080
